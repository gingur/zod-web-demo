{
  "name": "zod-web-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && storybook build --quiet -o dist/storybook",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:ci": "playwright install --with-deps chromium && vitest run",
    "lint": "devkit lint",
    "lint:fix": "devkit lint --fix",
    "fmt": "devkit fmt",
    "fmt:check": "devkit fmt --check",
    "staged": "devkit staged",
    "prepare": "devkit hooks install"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gingur/devkit": "git+https://github.com/gingur/devkit.git#main",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
